# PostgreSQL Database URL (Local PostgreSQL or Neon Cloud PostgreSQL)
# Example for Neon: postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/busbooking?schema=public"

# Authentication Secret
AUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

